# Supabase > Project Settings > API Keys (PUBLISHABLE KEY, never secret/service_role)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
# Production domain, no trailing slash. Local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# The existing Supabase backend is the safe default. Do not change unless
# explicitly running an authorized local Neon sandbox integration test.
# NAOSLEDGE_BACKEND=neon
# NEXT_PUBLIC_NAOSLEDGE_BACKEND=neon
# NAOSLEDGE_NEON_BRANCH_ID=br-quiet-sunset-b4xx4pnx
# NEON_AUTH_BASE_URL=https://YOUR_APPROVED_SANDBOX.neonauth.c-6.us-east-2.aws.neon.tech/neondb/auth
# NEON_DATA_API_URL=https://YOUR_APPROVED_SANDBOX.apirest.c-6.us-east-2.aws.neon.tech/neondb/rest/v1
# NEON_AUTH_COOKIE_SECRET=GENERATE_A_STRONG_SERVER_ONLY_RANDOM_VALUE_AT_LEAST_32_CHARACTERS
# NOTE: Neon test mode is pinned to the exact approved sandbox endpoint and
# will reject production/other branches. Never commit or publish a real secret.
